{
    if( FastNoise::SmartNode<> node = FastNoise::NewFromEncodedNodeTree( encodedString, (FastSIMD::FeatureSet)simdLevel ) )
    {
        FastNoise::Internal::BumpNodeRefences( node.get(), true );

        return node.get();
    }
    return nullptr;
}

