			return this.noise.maxValue();
		}

		@Override
		public Noise mapAll(Visitor visitor) {
			return visitor.apply(this);
		}

		@Override
		public Codec<Cached> codec() {
			throw new UnsupportedOperationException();
		}
	}
}
