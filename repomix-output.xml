		public Noise noise;
		public long lastPos = Long.MIN_VALUE;
		public float value;
		
		public Cached(Noise noise) {
			this.noise = noise;
		}
		
		@Override
		public float compute(float x, float z, int seed) {
			long newPos = PosUtil.packf(x, z);
			if(this.lastPos != newPos) {
