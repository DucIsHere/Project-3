    {
        SmartNode<> CreateNode( FastSIMD::FeatureSet ) const override;

        MetadataT()
        {
            groups.push_back( "Basic Generators" );
            this->AddVariable( { "Value", "Constant output" }, 1.0f, &Constant::SetValue );

            description =
                "Outputs a constant value";
        }
    };
#endif

